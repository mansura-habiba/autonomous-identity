        <mxCell id="L2" value="autonomous-identity library" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0d9cf;strokeColor=#b1421c;verticalAlign=top;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="320" height="720" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="HSM / TPM / TEE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="240" height="720" as="geometry" />
