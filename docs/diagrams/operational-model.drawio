        <mxCell id="L5" value="Receiver agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1200" y="80" width="180" height="780" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="1. Receives inbound call&#10;Reads parent envelope&#10;from Signature-Key header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. delegate(parent,&#10; child_subject,&#10; allowed_scopes=narrower)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="380" y="210" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. Check: allowed_scopes&#10; ⊆ parent.effective_scopes&#10;If not, raise&#10;scope_not_in_effective." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="380" y="290" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. Sign child SVID&#10;Append DELEGATE audit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="380" y="380" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. POST /process&#10;Signature-Key: child-SVID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="680" y="460" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6. Gateway invokes ExtAuthz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="920" y="540" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7. Verify signature&#10;Resolve lifecycle&#10;Compute effective_scopes&#10;Append EXTAUTHZ_ALLOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="920" y="610" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="8. Receiver handles request&#10;reads envelope &#x2014; binding via&#10;a2a-identity-middleware." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1220" y="710" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a1" style="endArrow=open;html=1;" edge="1" parent="1" source="s1" target="s2">
