        <mxCell id="s1" value="1. POST /tool/delete&#10;Signature-Key: SVID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. jwtAuth verifies signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="340" y="210" width="220" height="50" as="geometry" />
