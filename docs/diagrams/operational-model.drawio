        <mxCell id="L4" value="Storage / JWKS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="960" y="80" width="280" height="720" as="geometry" />
        </mxCell>

        <!-- Steps -->
        <mxCell id="s1" value="1. Process starts&#10;Load RuntimeConfig" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. Issue root envelope&#10;subject = spiffe://td/agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="380" y="210" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. Request signature&#10;over canonical envelope JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="720" y="280" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. Ed25519 sign&#10;return signature bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="720" y="350" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. Persist envelope&#10;Append ISSUE audit record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="980" y="420" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6. Cache envelope in process&#10;Return AgentIdentity handle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="380" y="490" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7. Agent ready.&#10;Begin processing inbound calls." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="560" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- arrows -->
