        <mxCell id="L4" value="autonomous-identity (receiver / sidecar)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0d9cf;strokeColor=#b1421c;verticalAlign=top;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="900" y="80" width="280" height="780" as="geometry" />
